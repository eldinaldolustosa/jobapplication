# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB — Local
# MONGODB_URI=mongodb://localhost:27017/jobapplicationDB

# MongoDB Atlas (replica set / cloud)
MONGODB_URI=mongodb://<user>:<password>@<host0>:27017,<host1>:27017,<host2>:27017/<dbname>?ssl=true&replicaSet=<replicaSet>&authSource=admin&appName=<appName>

# JWT — use strong random strings in production (e.g. openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Upload
UPLOAD_MAX_SIZE_MB=5
