{
  "name": "jobapplication-api",
  "version": "1.0.0",
  "description": "REST API for managing and tracking job applications",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node src/scripts/setupDB.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "cy:run:headless": "cypress run --headless --browser electron"
  },
  "keywords": [
    "job",
    "application",
    "tracker",
    "api",
    "express",
    "mongodb"
  ],
  "author": "Eldinaldo Lustosa",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  }
