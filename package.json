{
  "name": "jobapplication-api",
  "version": "1.0.0",
  "description": "REST API for managing and tracking job applications",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node src/scripts/setupDB.js",
    "test": "NODE_ENV=test mocha --config .mocharc.js",
    "test:watch": "NODE_ENV=test mocha --config .mocharc.js --watch",
    "test:report": "NODE_ENV=test mocha --config .mocharc.js --reporter mochawesome --reporter-options reportDir=reports/mocha,overwrite=false,html=false,json=true && marge reports/mocha/*.json --reportDir reports/mocha --inline",
    "test:coverage": "NODE_ENV=test mocha --config .mocharc.js --reporter mochawesome --reporter-options reportDir=reports/mocha",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "cy:report": "cypress run --reporter mochawesome --reporter-options reportDir=reports/cypress,overwrite=false",
    "test:all": "npm test && npm run cy:run"
  },
  "keywords": [
    "job",
    "application",
    "tracker",
    "api",
    "express",
    "mongodb"
  ],
  "author": "Eldinaldo Lustosa",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "cypress": "^15.14.2",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "nodemon": "^3.1.3",
    "supertest": "^7.2.2"
  }
}
