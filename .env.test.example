# Test Environment — copy to .env.test and fill in your test DB credentials
PORT=3001
NODE_ENV=test
BASE_URL=http://localhost:3001

# MongoDB — use a SEPARATE test database, never production
MONGODB_URI=mongodb://<user>:<pass>@<host>/jobapplicationTest?ssl=true&...

# JWT — use dedicated test secrets
JWT_SECRET=test_jwt_secret_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=2h

UPLOAD_MAX_SIZE_MB=5
